{
  "name": "sdd-workbench",
  "version": "0.2.1",
  "private": true,
  "description": "One SDD skill suite for Codex, Hermes, ZCode, DeepSeek Harness, OpenCode and Pi.",
  "main": "./adapters/deepseek.mjs",
  "exports": {
    ".": "./adapters/deepseek.mjs"
  },
  "keywords": [
    "agent-skills",
    "pi-package",
    "dsh-plugin",
    "sdd"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "skills",
    "adapters",
    "suite.json",
    "plugin.json",
    "agent-targets.json",
    "cordis.patch.yml",
    ".codex-plugin",
    ".agents/plugins",
    ".zcode-plugin",
    "marketplace.json",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    ".npmignore"
  ],
  "scripts": {
    "test:browser": "node skills/sdd-workflow-router/tests/browser_decisions.cjs && node skills/sdd-workflow-router/tests/browser_designs.cjs && node skills/sdd-workflow-router/tests/browser_live_feedback.cjs",
    "test:adapters": "node --test tests/test_deepseek_adapter.mjs",
    "test:forward-browser": "node tests/browser_recovery.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
